# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Leave these unset to run on the local seed data. The portal is fully usable
# that way — votes, follows and submissions live in process memory, and email
# sign-in is stubbed so every flow can be exercised without any setup. Google
# sign-in is disabled and says so.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS, so it must never reach the browser. Needed for
# writes and for reading a person's own votes: the `votes` policies keep
# who-voted-for-what private from the anon role.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Supabase → Connect → Session pooler, URI).
# Used only by `scripts/apply-migrations.ts` on a developer machine to run the
# SQL in supabase/migrations and supabase/seed.sql. The app never reads it.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Sign-in — configured in the Supabase dashboard, not here
# ---------------------------------------------------------------------------
# 1. Authentication → Providers → Google: add the OAuth client id and secret
#    from Google Cloud Console.
# 2. Authentication → URL Configuration → Redirect URLs, add (wildcards are
#    the safe form — Supabase matches the whole URL, query string included):
#      http://localhost:3000/**
#      https://news.flovoo.com/**
#      https://help.flovoo.com/**
# 3. Email sign-in uses Supabase's own magic-link mail. For production volume,
#    point Authentication → SMTP at a real sender.

# ---------------------------------------------------------------------------
# Canonical address
# ---------------------------------------------------------------------------
# Used for canonical links and the share-card image URL. Unset, it falls back
# to Vercel's project domain — which works, but names the wrong host once a
# custom domain is in front.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------
# Bootstrap list, comma separated. Something has to grant the first admin, and
# it cannot be the admin table. After that, add people to `admin_users` — that
# is the roster every RLS policy checks through `is_admin()`.
#
# Without Supabase the sign-in stub accepts any address without verification,
# so everyone is an admin there. That is bounded by the same guard that keeps
# the stub out of production.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Help center
# ---------------------------------------------------------------------------
# The help center is this same app served from its own host. Set the public
# address and `src/proxy.ts` maps that host onto the `/[locale]/help/*` routes
# while every link the pages render points at it. Leave it unset locally and
# the help center lives at http://localhost:3000/ar/help.
NEXT_PUBLIC_HELP_URL=

# Where the "didn't find what you need?" card sends people. Each button only
# renders when its address is set. Flovoo's own live chat and WhatsApp — never
# a third-party help desk.
NEXT_PUBLIC_HELP_CHAT_URL=
NEXT_PUBLIC_HELP_WHATSAPP_URL=

# Semantic search (optional). Any provider that speaks the OpenAI embeddings API
# shape works; leave the key unset and search is lexical only — still tolerant
# of hamza, ta marbuta and the definite article. Vectors are 1536-wide.
HELP_EMBEDDING_API_KEY=
HELP_EMBEDDING_MODEL=text-embedding-3-small
HELP_EMBEDDING_BASE_URL=https://api.openai.com/v1

# The AI Agent's read contract (/api/agent/v1/*). The content behind it is
# published help articles, so a key is optional: set one and callers must send
# it as `Authorization: Bearer …`; leave it unset and the endpoints are open.
# Either way they are rate limited per address.
HELP_AGENT_API_KEY=

# Indexing. Unset or false keeps every help page `noindex` and blocks them in
# robots.txt — the state to ship in until help.flovoo.com is pointed at this
# app and the content is ready to be found.
NEXT_PUBLIC_HELP_INDEXABLE=

# ---------------------------------------------------------------------------
# IndexNow (optional) — tells Bing a URL changed instead of waiting to be
# crawled. Copilot answers from Bing and ChatGPT Search leans on it, so this
# is how fast two major assistants see an edit. Any random 32+ character
# hex string; `next.config.ts` serves it back at /<key>.txt for verification.
# Unset means no pings are sent and nothing fails.
INDEXNOW_KEY=
