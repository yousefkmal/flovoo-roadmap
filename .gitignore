# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets, and a deploy needs it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

tsconfig.tsbuildinfo

# local media uploads (development without Supabase Storage)
/public/help-uploads

# Raw Intercom export — the migration safety net. Their content, kept on
# disk, not in the repo.
/migration/intercom-export

# Customer data pulled out of Intercom before it is closed: conversations,
# contacts, companies. Personal information — it stays on this machine, never
# in the repo and never in the database.
/migration/private-backup
